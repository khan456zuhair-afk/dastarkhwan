# 1. Supabase Postgres & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SERVER-SIDE ONLY: NEVER EXPOSE SERVICE ROLE KEY TO BROWSER CLIENTS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App Configuration
# 2. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sandbox Payment Gateway (e.g., Safepay Sandbox)
# 3. Online Payment Gateway Sandbox (e.g., Safepay Sandbox)
NEXT_PUBLIC_PAYMENT_SANDBOX_MODE=true
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=sec_sandbox_pk_xxxxxxxxxxxx
PAYMENT_SECRET_KEY=sec_sandbox_sk_xxxxxxxxxxxx
PAYMENT_WEBHOOK_SECRET=sec_sandbox_whsec_xxxxxxxxxxxx

